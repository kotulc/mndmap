{
  "name": "mndmap",
  "version": "0.2.0",
  "description": "Diagrams for static sites, drawn from the markdown they are published from.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mndmap": "dist/cli.js"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "demo":"npm run build && node dist/cli.js build docs --out dist/demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "try": "node scripts/try.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotulc/mndmap.git"
  },
  "license": "MIT",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "d3-hierarchy": "^3.1.3",
    "d3-shape": "^3.2.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0",
    "jsdom": "^29.1.1",
    "marked": "^18.3.0",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
