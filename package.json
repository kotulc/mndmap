{
  "name": "mndmap",
  "version": "0.1.0",
  "description": "A browser shell over a folder of markdown, one block per file.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs --open",
    "build": "vite build",
    "kit:types": "node scripts/kit-types.mjs",
    "meta": "node scripts/meta.mjs",
    "preview": "vite preview --outDir dist/ui --port 7342",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotulc/mndmap.git"
  },
  "license": "MIT",
  "dependencies": {
    "@mnd/kit": "file:vendor/mnd-kit-0.8.0.tgz",
    "@xyflow/react": "^12.11.6",
    "marked": "^18.0.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
